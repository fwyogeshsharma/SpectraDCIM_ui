# Form service for the demo, early access and partner forms.
# Both values are public: they end up in the page script.
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_KEY=
# Tracking script address (public). Example: https://track.example.com/t.js
# While testing on your own PC: http://127.0.0.1:8000/t.js (works only locally).
PUBLIC_TRACKING_SRC=
