---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Backdrop from '../components/Backdrop.astro';
import { lastmodFor } from '../data/dates';

interface Props {
  title: string;
  description: string;
  /** Sections that sit on the silk photo together with the header (hero, and on Home the marquee). */
  heroClass?: string;
  /** Hero background view: racks, aisle, heat, hall, site, net or world. Defaults by page. */
  bg?: string;
  /** Keep this page out of search results (the page-not-found page). */
  noindex?: boolean;
  /** Questions and answers shown on the page, word for word; they become FAQPage structured data. */
  faq?: { q: string; a: string }[];
}
const { title, description, heroClass = '', bg, noindex = false, faq = [] } = Astro.props;

// Hero background: a real 3-D, first-person or world-map view from the product (simulated estate),
// chosen to match what the page is about.
const byPath: Record<string, string> = {
  '/': 'fpv', // first-person view down a server-room aisle
  '/platform': 'building', // the whole building, every level
  '/platform/power': 'ups', // UPS room
  '/platform/thermal': 'heat', // hall colored by temperature
  '/platform/visualization': 'fpv', // first-person walk down the aisle
  '/platform/alarms': 'plant', // chiller plant, where the worked example starts
  '/platform/assets': 'racks',
  '/works-with': 'netroom', // network room
  '/solutions': 'world', // sites on the world map
  '/early-access': 'hall',
  '/partners': 'world',
  '/resources': 'aisle',
  '/company': 'building', // the whole facility (the compound view is the footer)
  '/demo': 'aisle',
};
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const view = bg ?? byPath[path] ?? 'hall';
// The one public address of this page: with a trailing slash, the form Netlify serves and every internal link uses.
const modified = lastmodFor(path);
const canonical = new URL(path === '/' ? '/' : `${path}/`, Astro.site).href;
// The picture a link preview shows. Source: assets/share/og.html.
const shareImage = new URL('/og.jpg', Astro.site).href;
const site = Astro.site!.href.replace(/\/$/, '');
// Structured data: who publishes the site, the site itself, this page, and where it sits.
const crumbs = path === '/' ? [] : path.split('/').filter(Boolean);
const crumbName = (seg: string, i: number) => (i === crumbs.length - 1 ? title : seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' '));
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'SpectraDCIM',
      url: `${site}/`,
      logo: { '@type': 'ImageObject', url: `${site}/brand/spectradcim-logo.webp`, contentUrl: `${site}/brand/spectradcim-logo.webp`, width: 860, height: 216 },
      description: 'Data center infrastructure management that watches power, cooling and IT as one.',
    },
    ...(faq.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${canonical}#faq`,
          url: canonical,
          mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
        }]
      : []),
    { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'SpectraDCIM', publisher: { '@id': `${site}/#organization` } },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title === 'Home' ? 'SpectraDCIM' : title,
      description,
      isPartOf: { '@id': `${site}/#website` },
      publisher: { '@id': `${site}/#organization` },
      inLanguage: 'en',
      dateModified: modified,
      ...(crumbs.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
    ...(crumbs.length
      ? [{
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
            ...crumbs.map((seg, i) => ({
              '@type': 'ListItem',
              position: i + 2,
              name: crumbName(seg, i),
              item: `${site}/${crumbs.slice(0, i + 1).join('/')}/`,
            })),
          ],
        }]
      : []),
  ],
};
// Visitor tracking script. Set PUBLIC_TRACKING_SRC to the tracker's public address, e.g. https://track.example.com/t.js
// (an http://127.0.0.1 address only works on the machine running the tracker). Left empty, nothing is added.
const trackingSrc = import.meta.env.PUBLIC_TRACKING_SRC;
const fullTitle = title === 'Home' ? 'SpectraDCIM | DCIM Software for Power, Cooling and IT' : `${title} | SpectraDCIM`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:updated_time" content={modified} />}
    <meta property="og:site_name" content="SpectraDCIM" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SpectraDCIM: a server hall in 3-D with a heat map and a replay timeline, on a simulated estate" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="theme-color" content="#000000" />
    {trackingSrc && !noindex && <script is:inline defer src={trackingSrc} data-site="spectradcim.com"></script>}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={`/bg/${view}-2400.webp`} media="(min-width: 801px)" />
    <!-- Content is visible without JavaScript; entrances only arm once this class is set. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <div class:list={['pbg', heroClass]}>
      <Backdrop view={view} />
      <slot name="hero" />
    </div>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
